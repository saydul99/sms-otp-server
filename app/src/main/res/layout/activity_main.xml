<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS CONFIGURATION"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <!-- 1. Target SMS Header Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target SMS Header (Sender ID)"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>
        
    <EditText
        android:id="@+id/et_target_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AX-ADHAAR-S"
        android:hint="e.g. AX-ADHAAR-S"
        android:inputType="textCapCharacters"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- 2. Testing SMS Header Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Testing SMS Header"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <EditText
        android:id="@+id/et_test_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CP-GDLCKT-S"
        android:hint="e.g. CP-GDLCKT-S"
        android:inputType="textCapCharacters"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <!-- 3. User ID Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Server ID"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <EditText
        android:id="@+id/et_user_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. user_123"
        android:inputType="text"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <!-- Server URL Input (Optional/Less Prominent) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server URL"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"/>

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://your-server.com/sms"
        android:inputType="textUri"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ACTIVATE"
        android:textStyle="bold"
        android:backgroundTint="@color/purple_500"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Waiting for Setup..."
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:textColor="@android:color/holo_red_dark"/>

</LinearLayout>